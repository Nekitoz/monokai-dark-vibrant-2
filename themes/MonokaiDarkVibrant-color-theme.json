{
  "$schema": "vscode://schemas/color-theme",
  "name": "Monokai Dark Vibrant 2",
  "type": "dark",
  "colors": {
    "focusBorder": "#528bff99",
    "foreground": "#D7DAE0",
    "widget.shadow": "#00000066",
    "scrollbar.shadow": "#00000066",
    "textLink.foreground": "#45A1ED",
    "textLink.activeForeground": "#19D1E5",
    "progressBar.background": "#528bff",
    "badge.background": "#528bff",
    "badge.foreground": "#F8FAFD",

    "activityBar.background": "#16171D",
    "activityBar.foreground": "#D7DAE0",
    "activityBar.inactiveForeground": "#6B717D",
    "activityBar.activeBorder": "#528bff",
    "activityBar.border": "#181A1F",
    "activityBarBadge.background": "#528bff",
    "activityBarBadge.foreground": "#F8FAFD",

    "button.background": "#528bff",
    "button.foreground": "#F8FAFD",
    "button.hoverBackground": "#6A9CFF",
    "button.secondaryBackground": "#2c313a",
    "button.secondaryForeground": "#D7DAE0",
    "button.secondaryHoverBackground": "#383E4A",
    "checkbox.background": "#1d1f23",
    "checkbox.border": "#3E4451",
    "dropdown.background": "#1d1f23",
    "dropdown.border": "#181A11",
    "input.background": "#1d1f23",
    "input.border": "#181A1F",
    "input.placeholderForeground": "#6B717D",
    "inputOption.activeBorder": "#528bff",

    "editor.background": "#16171D",
    "editor.foreground": "#f8f8f0",
    "editor.lineHighlightBackground": "#1F2328",
    "editor.selectionBackground": "#3E4451",
    "editor.selectionHighlightBackground": "#3E445180",
    "editor.wordHighlightBackground": "#3E445180",
    "editor.wordHighlightStrongBackground": "#4E566680",
    "editor.findMatchBackground": "#528bff66",
    "editor.findMatchHighlightBackground": "#314365",
    "editorCursor.foreground": "#f8f8f0",
    "editorError.foreground": "#c24038",
    "editorWarning.foreground": "#FF9700",
    "editorInfo.foreground": "#45A1ED",
    "editorLineNumber.foreground": "#495162",
    "editorLineNumber.activeForeground": "#D7DAE0",
    "editorIndentGuide.background1": "#3B4048",
    "editorIndentGuide.activeBackground1": "#6B717D",
    "editorRuler.foreground": "#484848",
    "editorWhitespace.foreground": "#484a50",
    "editorBracketMatch.background": "#3E445180",
    "editorBracketMatch.border": "#528bff80",
    "editorBracketHighlight.foreground1": "#FFD945",
    "editorBracketHighlight.foreground2": "#FF4DFF",
    "editorBracketHighlight.foreground3": "#19D1E5",
    "editorBracketHighlight.foreground4": "#FFD945",
    "editorBracketHighlight.foreground5": "#FF4DFF",
    "editorBracketHighlight.foreground6": "#19D1E5",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF3F4F",
    "editorInlayHint.background": "#21252B",
    "editorInlayHint.foreground": "#8B93A3",
    "editorStickyScroll.background": "#191B20",
    "editorStickyScroll.shadow": "#00000066",
    "editorStickyScrollHover.background": "#2c313a",
    "editorGutter.addedBackground": "#81F900B3",
    "editorGutter.modifiedBackground": "#FFD945B3",
    "editorGutter.deletedBackground": "#FF3F4FB3",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#c24038",
    "editorOverviewRuler.warningForeground": "#FF9700",
    "editorOverviewRuler.infoForeground": "#45A1ED",
    "editorOverviewRuler.addedForeground": "#81F90099",
    "editorOverviewRuler.modifiedForeground": "#FFD94599",
    "editorOverviewRuler.deletedForeground": "#FF3F4F99",

    "editorGroup.border": "#181A1F",
    "editorGroupHeader.tabsBackground": "#21252B",
    "editorHoverWidget.background": "#21252B",
    "editorHoverWidget.border": "#181A1F",
    "editorSuggestWidget.background": "#21252B",
    "editorSuggestWidget.border": "#181A1F",
    "editorSuggestWidget.selectedBackground": "#2c313a",
    "editorSuggestWidget.highlightForeground": "#19D1E5",
    "editorSuggestWidget.focusHighlightForeground": "#19D1E5",
    "editorWidget.background": "#21252B",
    "editorWidget.border": "#181A1F",

    "breadcrumb.background": "#16171D",
    "breadcrumb.foreground": "#9da5b4",
    "breadcrumb.focusForeground": "#D7DAE0",
    "breadcrumb.activeSelectionForeground": "#D7DAE0",
    "breadcrumbPicker.background": "#21252B",

    "minimap.background": "#16171D",
    "minimap.selectionHighlight": "#3E4451",
    "minimap.findMatchHighlight": "#314365",
    "minimapGutter.addedBackground": "#81F900B3",
    "minimapGutter.modifiedBackground": "#FFD945B3",
    "minimapGutter.deletedBackground": "#FF3F4FB3",

    "diffEditor.insertedTextBackground": "#00809B33",
    "diffEditor.removedTextBackground": "#FF3F4F33",

    "peekView.border": "#528bff",
    "peekViewEditor.background": "#191B20",
    "peekViewEditor.matchHighlightBackground": "#314365",
    "peekViewResult.background": "#1d1f23",
    "peekViewResult.matchHighlightBackground": "#314365",
    "peekViewResult.selectionBackground": "#2c313a",
    "peekViewTitle.background": "#21252B",

    "list.activeSelectionBackground": "#2c313a",
    "list.activeSelectionForeground": "#d7dae0",
    "list.focusBackground": "#383E4A",
    "list.highlightForeground": "#19D1E5",
    "list.hoverBackground": "#292d35",
    "list.inactiveSelectionBackground": "#2c313a",
    "list.inactiveSelectionForeground": "#d7dae0",

    "quickInput.background": "#21252B",
    "quickInput.foreground": "#D7DAE0",
    "quickInputList.focusBackground": "#2c313a",
    "quickInputTitle.background": "#282c34",

    "menu.background": "#21252B",
    "menu.foreground": "#D7DAE0",
    "menu.selectionBackground": "#2c313a",
    "menu.border": "#181A1F",

    "notifications.background": "#21252B",
    "notifications.border": "#181A1F",
    "notificationCenterHeader.background": "#282c34",
    "notificationToast.border": "#181A1F",

    "scrollbarSlider.activeBackground": "#747D9180",
    "scrollbarSlider.background": "#4E566680",
    "scrollbarSlider.hoverBackground": "#5A637580",

    "sideBar.background": "#191B20",
    "sideBar.border": "#181A1F",
    "sideBarSectionHeader.background": "#282c34",
    "sideBarSectionHeader.foreground": "#D7DAE0",

    "panel.background": "#191B20",
    "panel.border": "#181A1F",
    "panelTitle.activeBorder": "#528bff",
    "panelTitle.activeForeground": "#D7DAE0",
    "panelTitle.inactiveForeground": "#6B717D",

    "terminal.foreground": "#f8f8f0",
    "terminalCursor.foreground": "#f8f8f0",
    "terminal.ansiBlack": "#3E4451",
    "terminal.ansiRed": "#FF3F4F",
    "terminal.ansiGreen": "#81F900",
    "terminal.ansiYellow": "#FFD945",
    "terminal.ansiBlue": "#45A1ED",
    "terminal.ansiMagenta": "#FF4DFF",
    "terminal.ansiCyan": "#19D1E5",
    "terminal.ansiWhite": "#D7DAE0",
    "terminal.ansiBrightBlack": "#6B717D",
    "terminal.ansiBrightRed": "#FF6B77",
    "terminal.ansiBrightGreen": "#A4FF4D",
    "terminal.ansiBrightYellow": "#FFE680",
    "terminal.ansiBrightBlue": "#7ABDF5",
    "terminal.ansiBrightMagenta": "#FF85FF",
    "terminal.ansiBrightCyan": "#5CE3F0",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.addedResourceForeground": "#81F900",
    "gitDecoration.untrackedResourceForeground": "#81F900",
    "gitDecoration.modifiedResourceForeground": "#FFD945",
    "gitDecoration.deletedResourceForeground": "#FF3F4F",
    "gitDecoration.conflictingResourceForeground": "#FF9700",
    "gitDecoration.ignoredResourceForeground": "#6B717D",
    "gitDecoration.submoduleResourceForeground": "#45A1ED",

    "debugToolBar.background": "#21252B",
    "statusBar.background": "#1d1f23",
    "statusBar.border": "#181A1F",
    "statusBar.debuggingBackground": "#21252B",
    "statusBar.foreground": "#fff",
    "statusBar.noFolderBackground": "#21252B",
    "statusBarItem.hoverBackground": "#2c313a",
    "statusBarItem.remoteBackground": "#528bff",
    "statusBarItem.remoteForeground": "#F8FAFD",

    "tab.activeBackground": "#2c313a",
    "tab.activeForeground": "#D7DAE0",
    "tab.activeBorderTop": "#528bff",
    "tab.inactiveForeground": "#9da5b4",
    "tab.border": "#181A1F",
    "tab.inactiveBackground": "#21252B",

    "titleBar.activeBackground": "#282c34",
    "titleBar.activeForeground": "#9da5b4",
    "titleBar.inactiveBackground": "#282C34",
    "titleBar.inactiveForeground": "#6B717D"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#45A1ED",
    "type": "#45A1ED",
    "class": "#45A1ED",
    "interface": "#45A1ED",
    "enum": "#45A1ED",
    "typeParameter": "#45A1ED",
    "function": "#81F900",
    "method": "#81F900",
    "decorator": "#81F900",
    "parameter": "#FF9700",
    "property": "#FFFFFF",
    "enumMember": "#FF4DFF",
    "selfParameter": "#FF3F4F",
    "variable.defaultLibrary": "#45A1ED"
  },
  "tokenColors": [
    /**
     * COMMENTS
     */
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {
        "foreground": "#ABABAB",
        "fontStyle": ""
      }
    },
    {
      "name": "Comment annotations",
      "scope": ["storage.type.class.jsdoc"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Comment variable",
      "scope": ["variable.other.jsdoc"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    /**
     * Operators
     */
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    /**
     * Modifiers
     */
    {
      "name": "Default modifiers",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Class/Constructor modifier",
      "scope": ["storage.type"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    /**
     * Entities
     */
    {
      "name": "Functions",
      "scope": ["entity.name.function", "meta.function-call.generic"],
      "settings": {
        "foreground": "#81F900",
        "fontStyle": ""
      }
    },
    {
      "name": "Class types",
      "scope": ["entity.name.type"],
      "settings": {
        "foreground": "#45A1ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Inherritance",
      "scope": ["entity.other.inherited-class"],
      "settings": {
        "foreground": "#81F900",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Section",
      "scope": ["entity.name.section"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#81F900",
        "fontStyle": ""
      }
    },
    /**
     * Variables
     */
    {
      "name": "This",
      "scope": ["variable.language"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Constant",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Arguments",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#FF9700",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {
        "foreground": "#FFD945",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#FF4DFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language.boolean", "constant.language.json"],
      "settings": {
        "foreground": "#FF4DFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Object property",
      "scope": ["variable.other.object"],
      "settings": {
        "foreground": "#45A1ED",
        "fontStyle": ""
      }
    },
    /**
     * Punctuations
     */
    {
      "name": "Expressions begin/end",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.definition.interpolation.begin.bracket.curly",
        "punctuation.definition.interpolation.end.bracket.curly"
      ],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Variable accessor",
      "scope": ["punctuation.accessor", "punctuation.definition.entity"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Seprator key/value",
      "scope": ["punctuation.separator.key-value"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Seprator key/value mapping",
      "scope": ["punctuation.separator.key-value.mapping"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Headings",
      "scope": ["punctuation.definition.heading"],
      "settings": {
        "foreground": "#ABABAB",
        "fontStyle": ""
      }
    },
    /**
     * Keywords
     */
    {
      "name": "Keyword",
      "scope": ["keyword"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Other keywords",
      "scope": ["keyword.type"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    /**
     * Support
     */
    {
      "name": "Support",
      "scope": ["support"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Support functions",
      "scope": ["support.function"],
      "settings": {
        "foreground": "#81F900",
        "fontStyle": ""
      }
    },
    {
      "name": "Support class",
      "scope": ["support.class"],
      "settings": {
        "foreground": "#45A1ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Support class component",
      "scope": ["support.class.component"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Support class built in",
      "scope": ["support.class.builtin"],
      "settings": {
        "foreground": "#45A1ED",
        "fontStyle": ""
      }
    },
    {
      "name": "Support link",
      "scope": ["markup.underline"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    /**
     * Strings
     */
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#FF9700",
        "fontStyle": ""
      }
    },
    /**
     * Decorators
     */
    {
      "name": "Decorator",
      "scope": ["punctuation.decorator"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    /**
     * Invalid
     */
    {
      "name": "Invalid",
      "scope": ["invalid"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    /**
     * Markup
     */
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#19D1E5",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#ABABAB",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup list",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup bold/italic",
      "scope": ["markup.bold", "markup.italic"],
      "settings": {
        "foreground": "#FF9700",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#81F900",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#FF3F4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#FFD945",
        "fontStyle": ""
      }
    }
  ]
}
